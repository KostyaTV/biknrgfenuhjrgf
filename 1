print("⭐⟪Система☆рейтинга☆продуктов⟫⭐")

reyting = int(input("Введите рейтинг продускта (1-10): "))

match reyting:
    case 9 | 10:
        print("Отличный продукт! 🌟 Настоятельно рекомендую!")
    case 8 | 7:
        print("Выше среднего 🔥 Дорстаточно хорош")
    case 6 | 5:
        print("Средний продукт 😐 Можно попробовать")
    case 4 | 3 | 2 | 1:
        print("Плохой продукт ❌ Не рекомендую")
    case _:
        print("Введённое число должно быть от 1 до 10 😡")
