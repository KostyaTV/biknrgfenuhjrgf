print("📦⟪Отслеживание☆заказа⟫📦")
status = input("Введите свой статус (pending, processing, shipped, delivered, cancelled): ")

print("")
print("⌈‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾⌉")
print("| 📦СТАТУС ВАШЕГО ЗАКАЗА📦 |")
print("⌊___________________________⌋")
print("")

match status:
    case "pending":
        print("Статус: В ожидании 🕐")
        print("Описание: Ваш заказ ожидет обработки")
        print("Примерное время: 10-20 дней")
    case "processing":
        print("Статус: Обрабатывается 🧰")
        print("Описание: Ваш заказ обрабатывается к отправке")
        print("Примерное время: 6-9 дней")
    case "shipped":
        print("Статус: Отправлено ✈️")
        print("Описание: Ваш заказ находится в пути к вам")
        print("Примерное время: 2-5 дней")
    case "delivered":
        print("Статус: Доставлен 🙂")
        print("Описание: Ваш заказ уже у вас!")
        print("Примерное время: Он уже у вас!")
    case "cancelled":
        print("Статус: Отменён ✖️")
        print("Описание: По каким-то причинам ваш заказ был отменён")
        print("Примерное время: Никогда")
    case _:
        print('❌ Ошибка: Неизвестный статус "invalid_status"')
        print("Доступные статусы: pending, processing, shipped, delivered, cancelled")
